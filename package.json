    "test:battleflow": "node --import ./src/engine/testAssetStub.mjs src/engine/battleFlowCheck.mjs",
    "test:determinism": "node --import ./src/engine/testAssetStub.mjs src/engine/determinismCheck.mjs",
    "test:turnflow": "node --import ./src/engine/testAssetStub.mjs src/engine/turnFlowCheck.mjs",
    "test:eval": "node --import ./src/engine/testAssetStub.mjs src/engine/evalCheck.mjs",
    "test:trace": "node --import ./src/engine/testAssetStub.mjs src/engine/botTraceCheck.mjs",
    "test:legal": "node --import ./src/engine/testAssetStub.mjs src/engine/legalActionsCheck.mjs",
    "test:transition": "node --import ./src/engine/testAssetStub.mjs src/engine/transitionCheck.mjs",
    "test:melody": "node --import ./src/engine/testAssetStub.mjs src/engine/melodyCommitCheck.mjs",
    "test:slime": "node --import ./src/engine/testAssetStub.mjs src/engine/slimeCheck.mjs",
    "test:eleven": "node --import ./src/engine/testAssetStub.mjs src/engine/elevenCheck.mjs",
    "test:score": "node --import ./src/engine/testAssetStub.mjs src/engine/actionScoreCheck.mjs",
    "test:harness": "node --import ./src/engine/testAssetStub.mjs src/engine/harnessCheck.mjs",
    "test:skilltree": "node --import ./src/engine/testAssetStub.mjs src/engine/skillTreeCheck.mjs",
    "check:bundle": "esbuild src/rlsw-simulator-v3_8_1.jsx --bundle --outfile=/dev/null --loader:.png=dataurl --loader:.mp3=dataurl --loader:.jpg=dataurl --loader:.svg=dataurl --loader:.wav=dataurl --format=esm --external:react --external:react-dom",
    "bench:bot": "node --import ./src/engine/testAssetStub.mjs src/engine/bench.mjs",
    "test:riffparity": "node --import ./src/engine/testAssetStub.mjs src/riff/riffOffParity.test.mjs",
    "test:chroma": "node src/audio/chromaSelftest.mjs",
    "test:vision": "node src/vision/neckGeometrySelftest.mjs",
    "test:detect": "node src/vision/neckDetectSelftest.mjs",
